<main class="auth-shell">
  <section class="card">
    <div class="card-body">
      <h1>Create your account</h1>
      <p class="text-secondary mb-4">Set up your workspace in a few seconds.</p>
      <form action="/register" method="post">
        <div class="mb-3">
          <label for="username">Username</label>
          <input id="username" class="form-control" type="text" name="username" placeholder="Choose a username" autocomplete="username" required />
        </div>
        <div class="mb-3">
          <label for="password">Password</label>
          <input id="password" class="form-control" type="password" name="password" placeholder="At least 6 characters" autocomplete="new-password" required />
        </div>
        <div class="mb-4">
          <label for="role">Account type</label>
          <select id="role" name="role" class="form-select">
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
      </form>
    </div>
  </section>
</main>
