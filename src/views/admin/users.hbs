<main class="container page-shell admin-page">
  <header class="page-heading">
    <h1>Users</h1>
    <p>Manage account roles and access.</p>
  </header>
  <div class="admin-table-card">
    <table class="table table-dark">
      <thead><tr><th>Username</th><th>Role</th><th>Actions</th></tr></thead>
      <tbody>
        {{#each users}}
          <tr>
            <td>{{this.username}}</td>
            <td>{{this.role}}</td>
            <td>
              <form method="post" action="/admin/users/{{this._id}}/role">
                <select name="role" class="form-select">
                  <option value="user" {{#unless (eq this.role "admin")}}selected{{/unless}}>user</option>
                  <option value="admin" {{#if (eq this.role "admin")}}selected{{/if}}>admin</option>
                </select>
                <button class="btn btn-sm btn-primary" type="submit">Change</button>
              </form>
              <form method="post" action="/admin/users/{{this._id}}/delete">
                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</main>
