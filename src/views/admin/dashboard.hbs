{{! Admin dashboard showing users and tasks }}
<main class="container page-shell admin-page">
  <header class="page-heading">
    <h1>Admin dashboard</h1>
    <p>Manage users and review tasks across the workspace.</p>
  </header>

  <section class="admin-section">
    <h2 class="admin-section-title">Users</h2>
    <div class="admin-table-card">
      <table class="table table-dark">
        <thead><tr><th>Username</th><th>Role</th></tr></thead>
        <tbody>
          {{#each users}}
            <tr>
              <td>{{this.username}}</td>
              <td>{{this.role}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-section">
    <h2 class="admin-section-title">Tasks</h2>
    <div class="admin-table-card">
      <table class="table table-dark">
        <thead><tr><th>Title</th><th>Owner</th><th>Done</th></tr></thead>
        <tbody>
          {{#each tasks}}
            <tr>
              <td>{{this.title}}</td>
              <td>{{this.owner}}</td>
              <td>{{this.done}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
</main>
