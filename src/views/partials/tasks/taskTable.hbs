<section class="card task-list-card">
{{#if tasks.length}}
  <div class="task-table-wrap">
  <table class="table table-hover" data-testid="task-table">
    <thead>
      <tr>
        <th>N°</th>
        <th>Title</th>
        <th>Description</th>
        <th>Operations</th>
      </tr>
    </thead>
    <tbody>
      {{#each tasks}}
        <tr data-testid="task-row">
          <td>{{@index}}</td>
          <td class="task-title" data-testid="task-title-value">{{title}}</td>
          <td class="task-description">{{description}}</td>
          <td class="task-actions">
            {{#if done}}
              <a
                class="btn btn-success"
                href="/tasks/{{_id}}/toggleDone"
              >Done</a>
            {{else}}
              <a class="btn btn-dark" href="/tasks/{{_id}}/toggleDone">
                Undone
              </a>
            {{/if}}
            {{#if currentUser}}
              {{#if (eq currentUser.role "admin")}}
                <a href="/tasks/{{_id}}/delete" class="btn btn-danger">
                  Delete
                </a>
              {{/if}}
            {{/if}}
            <a href="/tasks/{{_id}}/edit" class="btn btn-info">
              Edit
            </a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
{{else}}
  <div data-testid="empty-tasks" class="empty-state d-flex flex-column align-items-center justify-content-center text-center">
    <div>
      <h2>No tasks yet</h2>
      <p>Add your first task to get started.</p>
      <img src="/icons/empty.svg" alt="" />
    </div>
  </div>
{{/if}}
</section>