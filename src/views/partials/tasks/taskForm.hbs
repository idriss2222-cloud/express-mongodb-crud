<section class="card card-body">
  <h3>Add a task</h3>
  <form action="/tasks/add" method="post" data-testid="task-form">

    {{! Title Input }}
    <div class="mb-3">
      <label for="title">Task title</label>
      <input
        id="title" data-testid="task-title-input"
        class="form-control"
        type="text"
        name="title"
        placeholder="Title"
        autofocus
      />
    </div>

    {{! Description Input }}
    <div class="mb-3">
      <label for="description">Description</label>
      <textarea
        class="form-control"
        name="description" data-testid="task-description-input"
        cols="80"
        placeholder="Add a Description"
      ></textarea>
    </div>

    <button class="btn btn-primary w-100" type="submit" data-testid="add-task-button">Add task</button>
  </form>
</section>